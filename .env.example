# URL do projeto Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anon (Project Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Segredo para proteger a rota /api/keep-alive do Vercel Cron (opcional no localhost)
CRON_SECRET=

# ID do Google Analytics 4 (Administrador > Fluxos de dados > ID da métrica, começa com G-). Vazio = sem Analytics.
NEXT_PUBLIC_GA_ID=
