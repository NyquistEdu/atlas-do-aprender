{
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/emails/diario",
      "schedule": "0 13 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "atlas-do-aprender.vercel.app"
        }
      ],
      "destination": "https://www.atlasdoaprender.com.br/:path*",
      "permanent": true
    }
  ]
}
