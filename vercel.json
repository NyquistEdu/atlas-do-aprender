{
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/emails/diario",
      "schedule": "0 13 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "atlas-do-aprender.vercel.app"
        }
      ],
      "destination": "https://www.atlasdoaprender.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/apostilas/caderno-de-conversa",
      "destination": "/livros",
      "permanent": false
    },
    {
      "source": "/caderno-de-conversa.pdf",
      "destination": "/livros",
      "permanent": false
    },
    {
      "source": "/apostilas/bruxa-matilda",
      "destination": "/tematicas",
      "permanent": false
    },
    {
      "source": "/bruxa-matilda.pdf",
      "destination": "/tematicas",
      "permanent": false
    },
    {
      "source": "/tematicas/halloween",
      "destination": "/tematicas",
      "permanent": false
    }
  ]
}
